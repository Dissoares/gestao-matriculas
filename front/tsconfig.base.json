{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": [
      "es2020",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@front/auth/guards": [
        "./libs/auth/guards/index.ts"
      ],
      "@front/auth/interceptors": [
        "./libs/auth/interceptors/index.ts"
      ],
      "@front/shared/enums": [
        "./libs/shared/enums/index.ts"
      ],
      "@front/shared/models": [
        "./libs/shared/models/index.ts"
      ],
      "@front/shared/services": [
        "./libs/shared/services/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}